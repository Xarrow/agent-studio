# Agent Studio 环境变量示例
#
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进版本库。
#
#   cp .env.example .env && vi .env

# ── 必填：主密钥 ──────────────────────────────────────────────────
# 用于加密入库的 LLM API Key（Fernet，对称加密）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠ 换了它，已入库的凭据将无法解密 —— 务必备份。
STUDIO_MASTER_KEY=

# ── 可选：覆盖默认路径 ────────────────────────────────────────────
# 数据库位置（默认 <项目>/data/studio.db）
# STUDIO_DB_PATH=
# Skill 物化 / 代码工具的工作目录（默认 <项目>/data/work）
# STUDIO_WORK_DIR=

# ── 可选：服务监听 ────────────────────────────────────────────────
# STUDIO_HOST=0.0.0.0
# STUDIO_PORT=8848

# ── 可选：对外 API（/v1/*）的鉴权 ─────────────────────────────────
# 留空 = 不校验（内网默认）；设了值则要求 Authorization: Bearer <key>
STUDIO_API_KEY=

# ── 可选：运行约束 ────────────────────────────────────────────────
# STUDIO_DEFAULT_TIMEOUT_S=300
# STUDIO_MAX_TOOL_OUTPUT_BYTES=65536
# STUDIO_LLM_PAYLOAD_LIMIT_BYTES=262144
