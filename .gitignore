# ═══════════════════════════════════════════════════════════════════
#  Agent Studio .gitignore
#
#  原则：**版本库只存"能重建的东西"** —— 源码、配置模板、锁文件。
#  凡是"运行产生"或"含密钥"的一律排除。
# ═══════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── 环境变量与密钥（绝不入库）────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ── 运行时数据 ────────────────────────────────────────────────────
# data/studio.db 里有：LLM 密钥密文、会话历史、长期记忆、执行记录
# 这是**用户数据**不是代码 —— 换了机器应该重新配置，而不是 clone 出来
data/

# ── 前端 ──────────────────────────────────────────────────────────
# web/ 下已有 Next.js 自带的 .gitignore（排除 node_modules / .next / .env*）
# 这里再兜一层：在仓库根执行 git add -A 时也不会误纳
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ── 备份与临时文件 ────────────────────────────────────────────────
# 改代码前的 *.bak-<日期> 备份留在本地，不进版本库（git 本身就是备份）
*.bak
*.bak-*
*.orig
*.rej
*.tmp
*.log
*.pid

# ── 编辑器 / 系统 ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
